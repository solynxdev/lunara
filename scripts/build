#!/usr/bin/env bash
# Build Lunara initramfs images.
#
# Usage:
#   scripts/build              Build RAM initramfs
#   scripts/build --persistent Build persistent-root initramfs

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"

BUILD_DIR="$PROJECT_ROOT/build"
ROOTFS="$PROJECT_ROOT/rootfs"
STAGING="$BUILD_DIR/userspace"

MODE="ram"

if [[ $# -gt 1 ]]; then
    echo "Usage: scripts/build [--persistent]" >&2
    exit 2
fi

if [[ $# -eq 1 ]]; then
    case "$1" in
        --persistent)
            MODE="persistent"
            ;;
        *)
            echo "error: unknown argument: $1" >&2
            echo "Usage: scripts/build [--persistent]" >&2
            exit 2
            ;;
    esac
fi

case "$MODE" in
    ram)
        INIT="$ROOTFS/init"
        OUTPUT="$BUILD_DIR/initramfs.cpio.gz"
        ;;
    persistent)
        INIT="$ROOTFS/init-persistent"
        OUTPUT="$BUILD_DIR/initramfs-persistent.cpio.gz"
        ;;
esac

for cmd in bash cpio find gzip mktemp cp du; do
    command -v "$cmd" >/dev/null 2>&1 || {
        echo "error: required command '$cmd' not found." >&2
        exit 1
    }
done

[[ -d "$ROOTFS" ]] || {
    echo "error: initramfs root directory missing: $ROOTFS" >&2
    exit 1
}

[[ -f "$INIT" ]] || {
    echo "error: init script missing: $INIT" >&2
    exit 1
}

mkdir -p "$BUILD_DIR"

echo "==> Building userspace"
bash "$SCRIPT_DIR/build-userspace"

[[ -x "$STAGING/bin/busybox" ]] || {
    echo "error: staged BusyBox binary missing." >&2
    exit 1
}

echo "==> Assembling $MODE initramfs"

TEMP_ROOT="$(mktemp -d "$BUILD_DIR/.initramfs.XXXXXX")"
TEMP_OUTPUT="$BUILD_DIR/.initramfs.cpio.gz.tmp"

cleanup() {
    rm -rf -- "$TEMP_ROOT"
    rm -f -- "$TEMP_OUTPUT"
}
trap cleanup EXIT

# Copy initramfs files, excluding host device nodes.
(
    cd "$ROOTFS"
    find . -mindepth 1 -maxdepth 1 ! -name dev \
        -exec cp -a -- {} "$TEMP_ROOT/" \;
)

# devtmpfs supplies device nodes at boot.
mkdir -p "$TEMP_ROOT/dev"

# Overlay the compiled BusyBox userspace.
cp -a "$STAGING/." "$TEMP_ROOT/"

# Select the correct init entry point.
if [[ "$MODE" == "persistent" ]]; then
    install -m 0755 "$INIT" "$TEMP_ROOT/init-persistent"
else
    install -m 0755 "$INIT" "$TEMP_ROOT/init"
fi

echo "==> Creating compressed archive"

(
    cd "$TEMP_ROOT"
    find . -print0 |
        cpio --null -o -H newc --owner=0:0 |
        gzip -9
) > "$TEMP_OUTPUT"

mv -f -- "$TEMP_OUTPUT" "$OUTPUT"

echo
echo "==> Build complete"
echo "    Mode:       $MODE"
echo "    Initramfs:  $OUTPUT"
echo "    Size:       $(du -h "$OUTPUT" | cut -f1)"
