#!/usr/bin/env bash
# Boot Lunara in QEMU.
#
# Usage:
#   scripts/boot
#   scripts/boot --persistent

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"

BUILD_DIR="$PROJECT_ROOT/build"
VERSION_FILE="$PROJECT_ROOT/config/kernel/version"
DISKROOT="$PROJECT_ROOT/diskroot"

MODE="ram"

if [[ $# -gt 1 ]]; then
    echo "Usage: scripts/boot [--persistent]" >&2
    exit 2
fi

if [[ $# -eq 1 ]]; then
    case "$1" in
        --persistent) MODE="persistent" ;;
        *)
            echo "error: unknown argument: $1" >&2
            exit 2
            ;;
    esac
fi

for cmd in qemu-system-x86_64 realpath sync; do
    command -v "$cmd" >/dev/null 2>&1 || {
        echo "error: required command '$cmd' not found." >&2
        exit 1
    }
done

[[ -s "$VERSION_FILE" ]] || {
    echo "error: kernel version file missing." >&2
    exit 1
}

KERNEL_VERSION="$(tr -d '[:space:]' < "$VERSION_FILE")"
KERNEL="$BUILD_DIR/kernel/$KERNEL_VERSION/vmlinuz"

[[ -s "$KERNEL" ]] || {
    echo "error: Lunara kernel missing: $KERNEL" >&2
    echo "Run scripts/build-kernel first." >&2
    exit 1
}

QEMU_ARGS=(
    -m 256M
    -smp 2
    -kernel "$KERNEL"
    -nographic
    -no-reboot
)

if [[ "$MODE" == "persistent" ]]; then
    INITRAMFS="$BUILD_DIR/initramfs-persistent.cpio.gz"
    DISK="$(realpath -e "$BUILD_DIR/lunara-rootfs.img")"

    [[ -s "$INITRAMFS" ]] || {
        echo "error: persistent initramfs missing." >&2
        echo "Run scripts/build --persistent first." >&2
        exit 1
    }

    [[ -s "$DISK" ]] || {
        echo "error: persistent disk image missing." >&2
        exit 1
    }

    # Ensure the host isn't accessing the image while QEMU runs.
    if mountpoint -q "$DISKROOT"; then
        MOUNT_SOURCE="$(findmnt -n -o SOURCE --target "$DISKROOT")"
        BACKING_FILE="$(sudo losetup -n -O BACK-FILE "$MOUNT_SOURCE")"

        if [[ "$(realpath -e "$BACKING_FILE")" != "$DISK" ]]; then
            echo "error: diskroot is mounted from a different image." >&2
            exit 1
        fi

        echo "==> Unmounting persistent root from host"
        sudo umount "$DISKROOT"
    fi

    # Refuse to boot if the image is mounted elsewhere.
    while IFS=: read -r LOOP_DEVICE _; do
        [[ -n "$LOOP_DEVICE" ]] || continue

        if findmnt -rn -S "$LOOP_DEVICE" >/dev/null; then
            echo "error: persistent image is mounted through $LOOP_DEVICE elsewhere." >&2
            exit 1
        fi
    done < <(sudo losetup -j "$DISK")

    QEMU_ARGS+=(
        -initrd "$INITRAMFS"
        -drive "file=$DISK,format=raw,if=virtio"
        -append "console=ttyS0,115200n8 rdinit=/init-persistent loglevel=3"
    )
else
    INITRAMFS="$BUILD_DIR/initramfs.cpio.gz"

    [[ -s "$INITRAMFS" ]] || {
        echo "error: initramfs missing. Run scripts/build first." >&2
        exit 1
    }

    QEMU_ARGS+=(
        -initrd "$INITRAMFS"
        -append "console=ttyS0,115200n8 rdinit=/init loglevel=3"
    )
fi

echo "==> Booting Lunara ($MODE mode)"
echo "    Kernel: $KERNEL"

if [[ "$MODE" == "persistent" ]]; then
    echo "    Disk:   $DISK"
fi

echo
echo "    Guest shutdown: run 'poweroff' inside Lunara"
echo "    QEMU exit:      Ctrl+A, then X"
echo

# Preserve QEMU's exit status while still flushing host writes.
set +e
qemu-system-x86_64 "${QEMU_ARGS[@]}"
QEMU_STATUS=$?
set -e

sync

echo
echo "==> QEMU exited (status $QEMU_STATUS)"

if [[ "$MODE" == "persistent" ]]; then
    echo "    The disk image is no longer in use."
    echo "    You can safely mount diskroot again."
fi

exit "$QEMU_STATUS"
